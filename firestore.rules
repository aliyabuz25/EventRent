rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.email is string && data.email.size() <= 256 &&
             data.role in ['admin', 'sales', 'client'] &&
             (data.displayName == null || (data.displayName is string && data.displayName.size() <= 128)) &&
             (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 512)) &&
             data.keys().hasAll(['email', 'role']);
    }

    function isValidProduct(data) {
      return data.name is string && data.name.size() <= 256 &&
             data.category is string && data.category.size() <= 128 &&
             data.description is string && data.description.size() <= 2000 &&
             data.technicalSpecs is map &&
             data.images is list && data.images.size() <= 10 &&
             data.tags is list && data.tags.size() <= 20 &&
             data.keys().hasAll(['name', 'category', 'description']);
    }

    function isValidLead(data) {
      return data.name is string && data.name.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.status in ['new', 'contacted', 'quoted', 'won', 'lost'] &&
             data.items is list && data.items.size() <= 50 &&
             (data.userId == null || (data.userId is string && data.userId.size() <= 128)) &&
             data.keys().hasAll(['name', 'email', 'status', 'items']);
    }

    function isValidConcept(data) {
      return data.name is string && data.name.size() <= 256 &&
             data.description is string && data.description.size() <= 2000 &&
             data.keys().hasAll(['name', 'description']);
    }

    function isValidSharedFile(data) {
      return data.name is string && data.name.size() <= 256 &&
             data.link is string && data.link.size() <= 1024 &&
             data.uploadedBy is string && data.uploadedBy.size() <= 128 &&
             data.keys().hasAll(['name', 'link', 'uploadedBy']);
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming()) && incoming().role == 'client';
      allow update: if (isOwner(userId) && isValidUser(incoming()) && incoming().role == existing().role) || isAdmin();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /teambuilding_concepts/{conceptId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leads/{leadId} {
      allow create: if isValidLead(incoming()) && 
                    (incoming().userId == null || isOwner(incoming().userId));
      allow get: if isAdmin() || (existing().userId != null && isOwner(existing().userId));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        isOwner(existing().userId) && 
        isValidLead(incoming()) && 
        existing().status == 'new' &&
        incoming().status == 'new' &&
        incoming().diff(existing()).affectedKeys().hasOnly(['items', 'note', 'eventDate', 'location'])
      );
      allow delete: if isAdmin();
    }

    match /shared_files/{fileId} {
      allow read: if true; // Public access for client links
      allow write: if isAdmin();
    }

    match /contact-submissions/{submissionId} {
      // Public write — anyone can submit contact form
      allow create: if incoming().name is string && incoming().name.size() <= 128 &&
                    incoming().email is string && incoming().email.size() <= 256 &&
                    incoming().phone is string && incoming().phone.size() <= 32 &&
                    incoming().message is string && incoming().message.size() <= 2000 &&
                    incoming().keys().hasAll(['name', 'email', 'phone', 'message']);
      // Only admins can read/manage submissions
      allow read, update, delete: if isAdmin();
    }
  }
}
