FROM node:22-alpine
WORKDIR /app
RUN apk add --no-cache python3 make g++ sqlite-dev sqlite
COPY package*.json ./
# Sadece backend bağımlılıklarını kur (dotenv, vite, react vs. dahil değil)
RUN npm ci --omit=dev \
    && npm uninstall dotenv --save 2>/dev/null || true \
    && apk del python3 make g++ sqlite-dev
COPY server.js ./
RUN mkdir -p /app/uploads /app/data
EXPOSE 4320
ENV HOST=0.0.0.0 \
    PORT=4320
CMD ["node", "server.js"]
