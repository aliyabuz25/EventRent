{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Additional user information including roles and permissions.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "sales", "client"] },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Event equipment catalog item.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "technicalSpecs": { "type": "object" },
        "images": { "type": "array", "items": { "type": "string" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "relatedProducts": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "category", "description"]
    },
    "Lead": {
      "title": "Lead",
      "description": "Potential customer inquiry with cart items.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "eventDate": { "type": "string", "format": "date-time" },
        "location": { "type": "string" },
        "note": { "type": "string" },
        "status": { "type": "string", "enum": ["new", "contacted", "quoted", "won", "lost"] },
        "items": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "quantity": { "type": "integer" },
              "technicalAnswers": { "type": "object" }
            }
          }
        },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "status", "items", "createdAt"]
    },
    "TeambuildingConcept": {
      "title": "Teambuilding Concept",
      "description": "Teambuilding service offering.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "participantCount": { "type": "string" },
        "isIndoor": { "type": "boolean" },
        "purpose": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "description"]
    },
    "SharedFile": {
      "title": "Shared File",
      "description": "Files shared with clients via unique links.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "link": { "type": "string" },
        "views": { "type": "integer" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "clientName": { "type": "string" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "link", "uploadedBy"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Individual user profiles and roles."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Equipment items in the catalog."
    },
    "/leads/{leadId}": {
      "schema": "Lead",
      "description": "Customer rental inquiries and requests."
    },
    "/teambuilding_concepts/{conceptId}": {
      "schema": "TeambuildingConcept",
      "description": "Available teambuilding activities."
    },
    "/shared_files/{fileId}": {
      "schema": "SharedFile",
      "description": "Metadata for files shared with clients."
    }
  }
}
